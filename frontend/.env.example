# ===========================================
# Ay Food — frontend (Vite / Vercel)
# Copy this file to: frontend/.env.local
# Vercel → Settings → Environment Variables
# ===========================================

# Required — Supabase Project Settings → API
# The anon key is public by design; security is enforced by RLS + admin tokens.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — only if you use a custom functions domain
# VITE_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Ay Food

# Optional — email hint only for the admin login form (NOT a secret)
VITE_ADMIN_EMAIL=contact@ayfoodpalace.com
# Admin password is stored hashed in Supabase (admin_credentials).
# Do NOT put the password in VITE_* — it would be exposed in the browser bundle.
# Change password in SQL (Supabase SQL editor):
#   update admin_credentials
#   set password_hash = extensions.crypt('YourNewStrongPassword', extensions.gen_salt('bf'))
#   where id = 'main';

# FormSubmit — admin alert when customer taps “I have made payment”
# First live submit sends an activation email to this inbox — click the link once.
VITE_FORMSUBMIT_EMAIL=your-alert-email@example.com
# Optional access key from formsubmit.co dashboard
# VITE_FORMSUBMIT_ACCESS_KEY=

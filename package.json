{
  "name": "ay-food",
  "version": "1.0.0",
  "private": true,
  "description": "Ay Food - Production Restaurant Ordering Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "cd backend && npm run build",
    "db:setup": "cd backend && npm run db:setup",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link",
    "supabase:push": "npx supabase db push",
    "supabase:functions": "npx supabase functions deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

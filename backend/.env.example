# Supabase PostgreSQL (recommended)
# Transaction pooler — use for the running app (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — use for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local PostgreSQL (optional, for offline dev)
# DATABASE_URL="postgresql://ayfood:ayfood_secret@localhost:5432/ayfood"
# DIRECT_URL="postgresql://ayfood:ayfood_secret@localhost:5432/ayfood"

JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Payment gateways
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Optional services
CLOUDINARY_URL=
RESEND_API_KEY=
